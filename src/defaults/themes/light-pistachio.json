// Light pistachio: from LexPen's theme of the same name, its app colours only.
// A theme lists only what differs from its base; the base may be any theme. The names are in the README (Themes).
{
  "name": "Light pistachio",
  "description": "pale yellow-green",
  "base": "light",
  "colors": {
    "bg": "#f5f8ea",
    "bgSide": "#ecf1dc",
    "bgBar": "#e3ead0",
    "fg": "#222817",
    "fgDim": "#5e6650",
    "border": "#d2dbb9",
    "accent": "#5b7a1e",
    "hover": "rgba(0, 0, 0, .06)",
    "select": "#dbe8b4"
  },
  // The pane themes (plan 13 3.6): the first the theme's own accent, then its base's without the nearest to it.
  "branches": ["#5b7a1e", "#0969da", "#cf222e", "#1a7f37", "#8250df", "#0f7b7b"]
}
