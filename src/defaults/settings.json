// Foldex's settings with their defaults. Do not change this file: your own settings.json in
// %LOCALAPPDATA%\Foldex holds only what you changed (you may edit it by hand, and copy it to another PC).
// The settings window (View > Foldex > Settings) shows them all.
{
  // ---------- General ----------
  "followWindows": true,          // light or dark as Windows is (Settings > Personalization > Colors), at once
  "theme": "light",               // "light" or "dark": the mode when not following Windows
  "themeLight": "light",          // the theme in light mode (a file name in themes\ without .json)
  "themeDark": "dark",            // the theme in dark mode

  // ---------- Panes ----------
  "showHidden": false,            // hidden and system files and folders shown (Ctrl+H, View > Hidden items)
}
