// Foldex's settings with their defaults. Do not change this file: your own settings.json in
// %LOCALAPPDATA%\Foldex holds only what you changed (you may edit it by hand, and copy it to another PC).
// The settings window (View > Foldex > Settings) shows them all.
{
  // ---------- General ----------
  "followWindows": true,          // light or dark as Windows is (Settings > Personalization > Colors), at once
  "theme": "light",               // "light" or "dark": the mode when not following Windows
  "themeLight": "light",          // the theme in light mode (a file name in themes\ without .json)
  "themeDark": "dark",            // the theme in dark mode

  // ---------- Projects ----------
  "projectsSort": "used-desc",    // Manage projects: "name", "created" or "used", then "-asc" or "-desc"
  "defaultLayout": {},            // the layout new projects start with (View > Projects > Save layout as default);
                                  // {} is Foldex's own: the tree at the left, its list beside it

  // ---------- Fonts ----------
  "appFont": "",                  // the window: ribbon, pane heads, location, status line; "" is Segoe UI
  "appSize": 10,                  // in points, 4 to 36
  "paneFont": "",                 // the rows of every pane; "" is Segoe UI
  "paneSize": 10,                 // in points, 4 to 36 (also Ctrl+mouse wheel over a pane)

  // ---------- Panes ----------
  "showHidden": false,            // hidden and system files and folders shown (Ctrl+H, View > Hidden items)
  "paneBgFocused": 100,           // the background of the pane with the keyboard, in %: 100 the theme's, 0 black, 200 white
  "paneBgBranch": 100,            // the background of the other panes in its branch (its parents, its children), the same way
  "paneBgOther": 100,             // the background of the other panes, the same way
  "treeExpanders": "chevron",     // a tree's expanders: "plus" (+ and -) or "chevron" (> and v)
  "treeLines": "dotted",          // a tree's lines: "dotted", "solid" or "none"
  "followDelay": 150,              // ms the cursor rests in a pane before its children follow it, 0 to 1000
  "searchDelay": 600,              // ms after typing in a pane before it filters (more than 3 characters) or jumps, 100 to 2000
  "focusIntensity": 100,          // the focused item's highlight, 0 to 200 %: 100 the theme's, lower fainter, higher stronger
  "selectIntensity": 100,         // the other selected items' highlight, the same way
  "hoverIntensity": 100,          // the highlight under the mouse, the same way
  "renameCompanions": true,       // renaming a file renames the files beside it with the same name and another extension; Shift+Enter: the other
  "scrollMargin": 0,               // rows kept in view above and below the cursor, 0 to 10: 1 scrolls on reaching the second last row
  "rowLines": "none",             // rows in a list: "none", "stripes" (every other row shaded) or "lines" (a line under each)
  "rowLinesIntensity": 8,         // 1 to 100: how strong the stripes or lines are, the text colour mixed in at that %
  "rowHeight": 170,               // the row height in % of the pane font size, 100 to 300 (the icons follow it)
  "paneThemeIntensity": 100,      // the branch colours, in %: 100 the theme's, 0 faint, 200 strong
  "paneHeadMix": 100,             // 0 to 100: pane heads and tabs, 0 the window's colour, 100 the branch colour
  "paneThemeMix": 8,              // 0 to 100: the inside of a pane, 0 the window's colours, 100 the branch colour
}
