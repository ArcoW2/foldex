// Foldex's settings with their defaults. Do not change this file: your own settings.json in
// %LOCALAPPDATA%\Foldex holds only what you changed (you may edit it by hand, and copy it to another PC).
// The settings window (View > Foldex > Settings) shows them all.
{
  // ---------- General ----------
  "followWindows": true,          // light or dark as Windows is (Settings > Personalization > Colors), at once
  "theme": "light",               // "light" or "dark": the mode when not following Windows
  "themeLight": "light",          // the theme in light mode (a file name in themes\ without .json)
  "themeDark": "dark",            // the theme in dark mode

  // ---------- Projects ----------
  "projectsSort": "used-desc",    // Manage projects: "name", "created" or "used", then "-asc" or "-desc"
  "defaultLayout": {},            // the layout new projects start with (View > Projects > Save layout as default);
                                  // {} is Foldex's own: the tree at the left, its list beside it

  // ---------- Fonts ----------
  "appFont": "",                  // the window: ribbon, pane heads, location, status line; "" is Segoe UI
  "appSize": 10,                  // in points, 4 to 36
  "paneFont": "",                 // the rows of every pane; "" is Segoe UI
  "paneSize": 10,                 // in points, 4 to 36 (also Ctrl+mouse wheel over a pane)

  // ---------- Panes ----------
  "showExtensions": true,          // a file's extension shown in the Name column and the icon views
  "renameSelect": "name",          // renaming one file (F2) selects: "name" (without the extension) or "all"
  "showHidden": false,           // hidden and system files and folders shown (Ctrl+H, View > Hidden items)
  "paneBgFocused": 100,           // the background of the pane with the keyboard, in %: 100 the theme's, 0 black, 200 white
  "paneBgBranch": 100,            // the background of the other panes in its branch (its parents, its children), the same way
  "paneBgOther": 100,             // the background of the other panes, the same way
  "treeExpanders": "chevron",     // a tree's expanders: "plus" (+ and -) or "chevron" (> and v)
  "treeLines": "dotted",          // a tree's lines: "dotted", "solid" or "none"
  "folderCacheMB": 256,            // MB the folder cache may keep (16 to 4096): folders read once, and read ahead
  "cacheNetwork": true,            // folders on network shares kept after shown and read ahead (off: only while shown)
  "ignoreActivationClick": true,   // a click on a window that is not in front only brings it to the front
  "ignoreRootPaneActivationClick": false,  // a click in a root pane (normally a tree) that is not active only makes it the active pane
  "ignoreChildPaneActivationClick": false, // a click in a child pane (normally a list) that is not active only makes it the active pane
  "quickAccess": true,             // the Quick access area at the top of a tree without a parent
  "treeLinesIntensity": 55,       // 1 to 100: how strong the tree lines are, the dim text colour at that %
  "followDelay": 150,              // ms the cursor rests in a pane before its children follow it, 0 to 1000
  "searchDelay": 600,              // ms after typing in a pane before it filters (more than 3 characters) or jumps, 100 to 2000
  "sortColumnIntensity": 200,     // the text of the columns the pane is sorted on, 0 to 200 %: 100 the theme's dim text, 200 the full text
  "otherColumnsIntensity": 160,   // the text of every other column, the name too, the same way
  "ribbonRememberTab": false,       // a window opens on the ribbon tab it showed when it closed; false: always on Home
  "ribbonGroupNames": true,        // the ribbon's group names under their buttons; false: a group's name is its tooltip
  "ribbonLabelWidth": 24,          // characters a small button's label may take before it is cut off with ..., 8 to 40
  "logDetail": "changes",         // what the Log shows besides errors and messages: messages, copies (copy, move), changes (also delete, new, rename), verbose (also every folder shown)
  "actionMessageSeconds": 2,     // seconds what an action did (Copied ...) stays lit in the status line, 1 to 30
  "sortColumnBackground": 6,      // the background of the columns sorted on, 0 to 50 %: their colour over the row (stripes, selection, focus blend)
  "sortColumnBackgroundColour": "", // that colour as #rrggbb; empty: the theme's text colour
  "focusIntensity": 100,          // the focused item's highlight, 0 to 200 %: 100 the theme's, lower fainter, higher stronger
  "selectIntensity": 100,         // the other selected items' highlight, the same way
  "hoverIntensity": 100,          // the highlight under the mouse, the same way
  "thumbnailCache": "foldex",      // where thumbnails are kept: "foldex" (Foldex's data folder) or "folder" (hidden, next to the images)
  "thumbnailCacheMB": 64,         // the thumbnail cache in Foldex's data folder at most, in MB; the ones used longest ago go first
  "thumbInfo": ["System.Photo.DateTaken", "System.Author", "System.Copyright", "System.Title"],   // shown by thumbnails in details and cards
  "thumbIcons": ["gps", "raw"],   // the icons on thumbnails: "gps" (a GPS location), "raw" (a camera RAW file)
  "previewRemoteImages": true,     // images from the internet shown in a markdown or HTML preview; false: nothing fetched
  "previewTextKB": 256,           // how much of a text-like file a preview reads, in KB (Show all reads the rest)
  "previewWindowsTypes": "",      // extensions (".pdf; .svg") shown by Windows' preview handler instead of Foldex's own viewer
  "renameTokens": "xplorer2",     // the Rename dialog's tokens: "xplorer2" ($B, $1, ${Date taken}) or "totalcommander" ([N], [C], [=Date taken])
  "renameCompanions": true,       // renaming a file renames the files beside it with the same name and another extension; Shift+Enter: the other
  "scrollbarsSlim": true,          // scrollbars drawn slim until the mouse is over their pane
  "scrollbarWidth": 12,             // px, 4 to 30: the vertical scrollbars' width
  "scrollbarHeight": 12,            // px, 4 to 30: the horizontal scrollbars' height
  "scrollMargin": 0,               // rows kept in view above and below the cursor, 0 to 10: 1 scrolls on reaching the second last row
  "rowLines": "none",             // rows in a list: "none", "stripes" (every other row shaded) or "lines" (a line under each)
  "rowLinesIntensity": 8,         // 1 to 100: how strong the stripes or lines are, the text colour mixed in at that %
  "rowHeight": 170,               // the row height in % of the pane font size, 100 to 300 (the icons follow it)
  "paneThemeIntensity": 100,      // the branch colours, in %: 100 the theme's, 0 faint, 200 strong
  "paneHeadMix": 100,             // 0 to 100: pane heads and tabs, 0 the window's colour, 100 the branch colour
  "paneThemeMix": 8,              // 0 to 100: the inside of a pane, 0 the window's colours, 100 the branch colour
}
