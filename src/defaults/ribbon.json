// The ribbon Foldex ships (docs/plans/executed/19-PLAN-ribbon-change-mode.md; as LexPen's). Change it in the window:
// right-click the ribbon > Change the ribbon (drag actions from F1 onto it, buttons, groups and tabs around and off
// it) or Customize...; Foldex then writes your own ribbon.json in %LOCALAPPDATA%\Foldex, which replaces this one whole.
// Reset to the shipped ribbon removes yours.
// Its tabs (docs/plans/executed/30-PLAN-ribbon-tabs.md): Home the everyday explorer work, View the panes and the
// projects, Customize the editing of what Foldex keeps, Tools Foldex itself. Every Manage window is in Tools > Manage; a
// group with a list of its own has it in its corners too (the left one its Manage), not as a button of its own.
//
// A tab: { "name", "groups" }. A group: { "name", "items", "corners" }.
// An item: "divider", or a button {
//   "action": an action's name (F1 lists them),
//   "params": its parameters, a variant of the action (["right"]),
//   "size": "large" (the full height, icon above its label) or "small" (the default: icon and label, a third of it),
//   "stack": true (under the small one before it, at most three in a column; or one under a large one alone),
//   "label": its text, shorter than the action's title; "\n" a line break on a large button,
//   "tip": its key tip, one or two letters (Alt shows them),
//   "open": "dropDown" (an action with a list and a window: its list under the button; the default its window) }.
// A group's "corners": { "left", "right" }: a small button beside the group's name (as LexPen: the left one its
// manager, the right one its list), each an action's name,
// [action, ...params], or { "action", "params", "open" }.
// A button whose action has variants or a list (Views, Bookmarks, Drives) has an arrow that lists them.
{
  "tabs": [
    { "name": "Home", "groups": [
      { "name": "Clipboard", "items": [
        { "action": "item.paste", "size": "large", "label": "Paste" },
        { "action": "item.copy", "label": "Copy" }, { "action": "item.cut", "label": "Cut", "stack": true },
        { "action": "item.copyPath", "label": "Copy path", "stack": true },
        { "action": "link.paste", "label": "Paste link" } ] },
      { "name": "Organize", "items": [
        { "action": "item.delete", "size": "large", "label": "Delete" },
        { "action": "file.new" }, { "action": "folder.new", "label": "New\nfolder", "stack": true },
        { "action": "item.rename", "label": "Rename", "stack": true } ] },
      { "name": "Open", "items": [
        { "action": "item.open", "size": "large", "label": "Open" },
        { "action": "item.properties", "label": "Properties" }, { "action": "item.selectAll", "label": "Select all", "stack": true } ] },
      { "name": "Find", "items": [
        { "action": "find", "size": "large", "label": "Find" }, { "action": "search.focus", "label": "Search bar", "stack": true },
        { "action": "scrap.new", "label": "New scrap" }, { "action": "scrap.add", "label": "Add to scrap", "stack": true } ] },
      { "name": "Go", "corners": { "left": "bookmarks.manage", "right": "bookmarks.menu" }, "items": [
        { "action": "history.back", "label": "\n" }, { "action": "history.forward", "label": "\n", "stack": true },
        { "action": "folder.up", "label": "\n", "stack": true },
        { "action": "bookmarks.menu", "size": "large", "label": "Bookmarks" },
        { "action": "refresh", "label": "Refresh" }, { "action": "drives.list", "label": "Drives", "stack": true, "tip": "D" } ] },
      { "name": "Filter", "corners": { "left": "filters.manage", "right": "filters.list" }, "items": [
        { "action": "filters.list", "size": "large" },
        { "action": "hidden.toggle", "size": "large", "label": "Hidden", "tip": "H" } ] },
      { "name": "Show", "items": [
        { "action": "view.menu", "size": "large", "label": "Views" },
        { "action": "preview.toggle", "size": "large", "label": "Preview", "tip": "P" },
        { "action": "preview.float", "label": "In window", "stack": true } ] } ] },

    { "name": "View", "groups": [
      { "name": "Panes", "items": [
        { "action": "pane.newChild", "params": ["right"], "size": "large", "label": "New child\npane" },
        { "action": "pane.newTab", "label": "New tab" }, { "action": "pane.new", "label": "New pane", "stack": true },
        { "action": "pane.close", "label": "Close pane", "stack": true },
        { "action": "pane.toggle", "label": "Show/hide pane" }, { "action": "pane.hidden", "label": "Hidden panes", "stack": true },
        { "action": "pane.rename", "label": "Rename pane", "stack": true },
        { "action": "pane.next", "label": "Next pane" },
        { "action": "pane.detach", "label": "Detach", "stack": true }, { "action": "pane.pin", "label": "Pin", "stack": true } ] },
      { "name": "Preview", "items": [
        { "action": "info.toggle", "size": "large", "label": "Info" },
        { "action": "preview.pane", "label": "Pane preview" }, { "action": "info.pane", "label": "Pane info", "stack": true } ] },
      { "name": "Layout", "items": [
        { "action": "layout.preset", "params": ["default"], "label": "Default" },
        { "action": "layout.preset", "params": ["dual"], "label": "Dual", "stack": true },
        { "action": "layout.preset", "params": ["columns"], "label": "Columns", "stack": true },
        { "action": "layout.preset", "params": ["preview"], "label": "Preview" } ] },
      { "name": "Projects", "corners": { "left": "projects.manage", "right": "projects.menu" }, "items": [
        { "action": "projects.menu", "size": "large", "label": "Projects" },
        { "action": "project.new", "label": "New" }, { "action": "project.rename", "label": "Rename", "stack": true } ] },
      { "name": "Profiles", "corners": { "left": "profiles.manage", "right": "profiles.menu" }, "items": [
        { "action": "profiles.menu", "size": "large", "label": "Profiles" },
        { "action": "profile.copy", "label": "Copy" }, { "action": "profile.rename", "label": "Rename", "stack": true },
        { "action": "profile.password", "label": "Password" }, { "action": "profile.close", "label": "Close", "stack": true } ] },
      { "name": "Columns", "items": [
        { "action": "columns.fitName", "label": "Fit columns" },
        { "action": "columns.fit", "label": "Fit all columns", "stack": true },
        { "action": "folders.size", "label": "Folder sizes", "stack": true } ] } ] },

    { "name": "Customize", "groups": [
      { "name": "Bookmarks", "corners": { "left": "bookmarks.manage", "right": "bookmarks.menu" }, "items": [
        { "action": "bookmarks.add", "label": "Add current folder" } ] },
      { "name": "Columns", "items": [
        { "action": "columns.manage", "label": "Column sets" } ] },
      { "name": "Bars", "items": [
        { "action": "bars.change", "label": "Change bars" },
        { "action": "bars.reset", "label": "Reset bars", "stack": true },
        { "action": "bars.add", "params": ["path"], "label": "Add path bar" },
        { "action": "bars.add", "params": ["drives"], "label": "Add drives bar", "stack": true },
        { "action": "bars.add", "params": ["search"], "label": "Add search bar", "stack": true } ] },
      { "name": "Ribbon", "items": [
        { "action": "ribbon.change", "label": "Change the ribbon" },
        { "action": "ribbon.customize", "label": "Customize...", "stack": true },
        { "action": "ribbon.reset", "label": "Reset the ribbon", "stack": true } ] },
      { "name": "Layout", "items": [
        { "action": "layout.saveDefault", "label": "Save layout as default" },
        { "action": "layout.resetDefault", "label": "Reset layout", "stack": true } ] } ] },

    { "name": "Tools", "groups": [
      { "name": "Macros", "corners": { "left": "macros.manage", "right": "macros.menu" }, "items": [
        { "action": "macros.menu", "size": "large", "label": "Macros" } ] },
      { "name": "Manage", "items": [
        { "action": "bookmarks.manage", "label": "Bookmarks" }, { "action": "filters.manage", "label": "Filters", "stack": true },
        { "action": "projects.manage", "label": "Projects" }, { "action": "macros.manage", "label": "Macros", "stack": true },
        { "action": "profiles.manage", "label": "Profiles", "stack": true } ] },
      { "name": "Foldex", "items": [
        { "action": "settings.open", "size": "large", "label": "Settings" },
        { "action": "palette", "label": "All actions" },
        { "action": "log.toggle", "label": "Log", "stack": true },
        { "action": "about", "label": "About", "stack": true } ] } ] }
  ]
}
