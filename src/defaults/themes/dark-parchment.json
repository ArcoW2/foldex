  "name": "Dark parchment",
  "description": "warm yellow, old paper at night",
  "base": "dark",
  "colors": {
    "bg": "#221e14",
    "bgSide": "#29241a",
    "bgBar": "#2f291d",
    "fg": "#ece3cc",
    "fgDim": "#a99f86",
    "border": "#463d2a",
    "accent": "#e0b84a",
    "select": "#5c4a1f"
  },
  // The pane themes (plan 13 3.6): the first the theme's own accent, then its base's without the nearest to it.
  "branches": ["#e0b84a", "#4fa3ff", "#ff6b6b", "#4cc76a", "#b392f0", "#39c5bb"]
}
