// Foldex's keys. Do not change this file: your own keys.json in %LOCALAPPDATA%\Foldex overrides it key by key
// ("F5": null takes a key away). F1 lists every action with its keys. A chord is two keys: "Ctrl+K, K".
// Moving the cursor in a pane (arrows, Page Up / Down, Home, End, with Shift and Ctrl) is fixed, not in this file.
{
  "F1": "palette",
  "Ctrl+F1": "ribbon.onDemand",
  "Ctrl+Alt+F": "filters.toggle",
  "Esc": "filters.escape",          // the search bar's filter emptied; without one, the pane's filter off
  "Enter": "item.execute",
  "Alt+Enter": "item.properties",
  "Del": "item.delete",
  "Alt+Del": "item.deleteDisk",
  "Shift+Del": "item.deletePermanent",
  "Alt+Shift+Del": "item.deletePermanent",
  "Ctrl+F": "find",
  "Ctrl+C": "item.copy",
  "Ctrl+X": "item.cut",
  "Ctrl+V": "item.paste",
  "Ctrl+Shift+C": "item.copyPath",
  "Ctrl+Alt+C": "item.copyPathsLine",
  "Ctrl+A": "item.selectAll",
  "F8": "folder.new",
  "Ctrl+Shift+N": "folder.new",
  "F7": "file.new",
  "F2": "item.rename",
  "Backspace": "folder.up",
  "Alt+Up": "folder.up",
  "Ctrl+Left": "folder.up",         // back up the tree, as Alt+Left goes back in the history (a text field keeps it: a word left)
  "Alt+Left": "history.back",
  "Alt+Right": "history.forward",
  "Alt+Shift+Left": "pane.toParent",
  "Alt+Shift+Right": "pane.toChild",
  "Alt+Shift+Down": "branch.next",
  "Tab": "branch.down",
  "Shift+Tab": "branch.up",
  "F5": "refresh",
  "Ctrl+D": "folders.size",
  "Ctrl+R": "columns.fitName",
  "Ctrl+Shift+R": "columns.fit",
  "Ctrl+H": "hidden.toggle",
  "Ctrl+Shift+F": "search.focus",
  "Alt+P": "preview.toggle",
  "F3": "preview.float",
  "Alt+I": "info.toggle",
  "Ctrl+Alt+N": ["pane.newChild", "right"],
  "Ctrl+Alt+Shift+N": "pane.new",
  "Ctrl+T": "pane.newTab",
  "Ctrl+W": "pane.close",
  "Ctrl+O": "pane.toggle",
  "Ctrl+Shift+O": "pane.openInOther",
  "F6": "pane.next",
  "Shift+F6": "pane.previous",
  "Ctrl+Alt+Left": ["pane.toSide", "left"],
  "Ctrl+Alt+Right": ["pane.toSide", "right"],
  "Ctrl+Alt+Up": ["pane.toSide", "up"],
  "Ctrl+Alt+Down": ["pane.toSide", "down"],
}
